# ===== 应用 =====
PROJECT_NAME=栖木家具官网 API
API_V1_PREFIX=/api/v1

# ===== 数据库 =====
# 开发用 SQLite（单文件 app.db）；生产切 PostgreSQL 时改为：
#   postgresql+asyncpg://user:pass@host:5432/dbname
# 并通过 alembic 迁移，勿直接改表结构。
DATABASE_URL=sqlite:///./app.db

# ===== JWT 鉴权 =====
# 生产请替换为强随机串：openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=604800

# ===== CORS（开发期前端端口）=====
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ===== 文件上传 =====
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# ===== 手机号 AES-256-GCM 加密密钥 =====
# 32 字节 base64：openssl rand -base64 32
PHONE_ENCRYPT_KEY=

# ===== 初始超管（首次 init_db 写入，部署后请在后台修改密码）=====
INIT_ADMIN_USER=admin
INIT_ADMIN_PASSWORD=change-me-in-production
